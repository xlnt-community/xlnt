if(XLNT_DEPENDENCIES_CONFIGURED)
  return()
endif()
set(XLNT_DEPENDENCIES_CONFIGURED TRUE)

if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(XLNT_USE_SYSTEM_LIBS)
    message(FATAL_ERROR "XLNT_USE_SYSTEM_LIBS is only supported on Linux")
  endif()
  return()
endif()

option(XLNT_USE_SYSTEM_LIBS "Use system dependencies instead of bundled libraries (Linux only)" OFF)
if(NOT XLNT_USE_SYSTEM_LIBS)
  return()
endif()

if(CMAKE_VERSION VERSION_LESS 3.13)
  message(FATAL_ERROR "XLNT_USE_SYSTEM_LIBS requires CMake 3.13 or newer")
endif()

find_package(PkgConfig REQUIRED)
pkg_check_modules(STUDXML REQUIRED IMPORTED_TARGET GLOBAL libstudxml)
find_package(fmt REQUIRED)
find_package(ZLIB REQUIRED)
find_path(UTFCPP_INCLUDE_DIR utf8.h PATH_SUFFIXES utf8cpp)
find_path(FAST_FLOAT_INCLUDE_DIR fast_float/fast_float.h)
if(NOT UTFCPP_INCLUDE_DIR OR NOT FAST_FLOAT_INCLUDE_DIR)
  message(FATAL_ERROR "XLNT_USE_SYSTEM_LIBS requires utfcpp and fast_float headers")
endif()
